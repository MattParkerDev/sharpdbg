<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>

	<PackageId>SharpDbg</PackageId>
	<Authors>MattParkerDev</Authors>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>readme.md</PackageReadmeFile>
	<PackageVersion>0.1.17</PackageVersion>
	<PackageProjectUrl>https://github.com/MattParkerDev/sharpdbg</PackageProjectUrl>
	<Description>A managed .NET Debugger implementing the Debug Adapter Protocol</Description>
	<PackageTags>Csharp Dotnet Debugger Debugging ICorDebug</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpDbg.Application\SharpDbg.Application.csproj" PrivateAssets="all" />
	<ProjectReference Include="..\SharpDbg.Infrastructure\SharpDbg.Infrastructure.csproj" PrivateAssets="all" />
	<ProjectReference Include="..\SharpDbg.DapProtocol\SharpDbg.DapProtocol.csproj" PrivateAssets="all" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Tenekon.MSBuild.Packaging.ProjectBuildInPackage" Version="2.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<PackageReference Include="Microsoft.Diagnostics.DbgShim" Version="10.0.750501" />

		<!-- We must include all package references required by projects that we reference -->
		<PackageReference Include="Ardalis.GuardClauses" Version="5.0.0" />
		<PackageReference Include="ICorDebugSharp" Version="0.1.8" />
		<PackageReference Include="ICSharpCode.Decompiler" Version="11.2.0.10050" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
		<PackageReference Include="MP.Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler" Version="5.9.0" />
		<PackageReference Include="NeoSmart.AsyncLock" Version="3.2.1" />
		<PackageReference Include="ZLinq" Version="1.6.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="readme.md" Pack="true" PackagePath="\" />
		<None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
