<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

	<ItemGroup>
		<Publicize IncludeCompilerGeneratedMembers="false" Include="Microsoft.CodeAnalysis" />
		<Publicize IncludeCompilerGeneratedMembers="false" Include="Microsoft.CodeAnalysis.CSharp" />
		<Publicize IncludeCompilerGeneratedMembers="false" Include="Microsoft.CodeAnalysis.ExpressionEvaluator.ExpressionCompiler" />
		<Publicize IncludeCompilerGeneratedMembers="false" Include="Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler" />
		<Publicize IncludeCompilerGeneratedMembers="false" Include="ICSharpCode.Decompiler" MemberPattern="^ICSharpCode\.Decompiler\.(CSharp\.Transforms\.RemoveEmbeddedAttributes|DebugInfo)\..*" />
	</ItemGroup>

  <ItemGroup>
	<PackageReference Include="Krafs.Publicizer" Version="2.3.2">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
    <PackageReference Include="Ardalis.GuardClauses" Version="5.0.0" />
	<PackageReference Include="ICorDebugSharp" Version="0.1.8" />
	<PackageReference Include="ICSharpCode.Decompiler" Version="11.2.0.10050" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
	<PackageReference Include="MP.Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler" Version="5.9.0" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageReference Include="NeoSmart.AsyncLock" Version="3.2.1" />
    <PackageReference Include="ZLinq" Version="1.6.1" />
  </ItemGroup>

</Project>
