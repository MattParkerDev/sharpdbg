<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<!-- The .NET 11 SDK still compiles async methods to state machines unless asked for runtime async -->
		<Features>runtime-async=on</Features>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);CS0168;CS0219;CS0414</NoWarn> <!-- Disable unused variable warnings -->
	</PropertyGroup>

</Project>
